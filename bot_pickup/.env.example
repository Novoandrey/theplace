# --- The Place · bot_pickup · пример окружения ---
# Скопировать в .env и заполнить. .env в гит НЕ коммитим (секреты — конституция §6).
# Хосты postgres/redis ниже — имена сервисов docker-compose. Для локального запуска
# без docker замените на localhost.

# === v0-core: обязательные ===
BOT_TOKEN=123456:PASTE_YOUR_TELEGRAM_BOT_TOKEN
STAFF_CHAT_ID=-1000000000000
DATABASE_URL=postgresql+asyncpg://theplace:theplace@postgres:5432/theplace
REDIS_URL=redis://redis:6379/0

# Учётка postgres для сервиса БД в docker-compose (должна совпадать с DATABASE_URL).
POSTGRES_USER=theplace
POSTGRES_PASSWORD=theplace
POSTGRES_DB=theplace

# === Каналы доставки и источник меню ===
# Список sink'ов через запятую. v0-core: только Telegram-чат кухни (бэкап всегда включён).
ENABLED_SINKS=telegram
# Источник меню: json | sheet | quickresto. v0 — локальный файл-зеркало.
MENU_SOURCE=json
MENU_PATH=data/menu.json
# Флаг шага выбора времени самовывоза (US-A4). v0-core — выключен.
PICKUP_TIME_ENABLED=false

# === prod (вебхук вместо long-polling) ===
# WEBHOOK_URL=https://bot.example.ru/webhook

# === Quick Resto открытое API (v1 — QuickRestoMenuSource) ===
# Логин/пароль API — из Предприятие → Настройки.
# QUICKRESTO_BASE_URL=
# QUICKRESTO_API_LOGIN=
# QUICKRESTO_API_PASSWORD=

# === Позже ===
# Закрытое API QR (путь A, v1.1) — параметры по итогам звонка.
# QUICKRESTO_CLOSED_API_URL=
# QUICKRESTO_CLOSED_API_TOKEN=
# Точка СБП (оплата, v1.1).
# TOCHKA_CLIENT_ID=
# TOCHKA_CLIENT_SECRET=
# TOCHKA_CUSTOMER_CODE=
